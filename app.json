{
  "expo": {
    "name": "empilhadeira-app",
    "slug": "empilhadeira-app",
    "version": "1.0.2",
    "orientation": "default",
    "icon": "src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.empilhadeira.app",
      "versionCode": 3,
      "adaptiveIcon": {
        "backgroundColor": "#F5B700",
        "foregroundImage": "src/assets/icon.png",
        "monochromeImage": "src/assets/icon.png"
      }
    },
    "web": {
      "favicon": "src/assets/icon.png"
    },
    "plugins": [
      "expo-font",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "O app usa o Bluetooth para controlar a empilhadeira."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f87065b0-ca25-44c5-88c2-1ef9e5f9bd5f"
      }
    }
  }
}
